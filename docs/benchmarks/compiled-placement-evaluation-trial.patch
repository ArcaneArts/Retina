diff --git a/native/src/decoration/placement/evaluation_tests.rs b/native/src/decoration/placement/evaluation_tests.rs
new file mode 100644
index 0000000..eb5ba6d
--- /dev/null
+++ b/native/src/decoration/placement/evaluation_tests.rs
@@ -0,0 +1,249 @@
+//! Differential reference retained from the pre-specialization evaluator.
+use super::*;
+use serde_json::json;
+
+#[test]
+fn compiled_evaluation_matches_registry_dispatch_and_parent_cache() {
+    let programs = [
+        json!([
+            {"type":"count","count":3},{"type":"in_square"},
+            {"type":"heightmap","map":1},{"type":"count","count":5},
+            {"type":"block_predicate_filter","predicate":{"type":"true"}},
+            {"type":"heightmap","map":5},{"type":"biome"}
+        ]),
+        json!([
+            {"type":"height_range","height":{"type":"constant","value":{"absolute":64}}},
+            {"type":"offset","x":1,"y":2,"z":-1},
+            {"type":"surface_relative_threshold_filter","map":1,"min_inclusive":-8,"max_inclusive":8},
+            {"type":"count","count":3},
+            {"type":"surface_water_depth_filter","max_water_depth":2}
+        ]),
+        json!([
+            {"type":"cuboid","xz_size":2,"y_size":2},
+            {"type":"environment_scan","direction":-1,"max_steps":16,
+             "target_condition":{"type":"material","offset":[0,0,0],"allowed":[2,3]},
+             "allowed_search_condition":{"type":"true"}},
+            {"type":"count","count":5},
+            {"type":"block_predicate_filter","predicate":{"type":"material","offset":[0,0,0],"allowed":[2,3]}}
+        ]),
+        json!([
+            {"type":"count_on_every_layer","count":2},
+            {"type":"block_predicate_filter","predicate":{"type":"not","predicate":{"type":"true"}}},
+            {"type":"heightmap","map":1}
+        ]),
+        json!([
+            {"type":"block_predicate_filter","predicate":{"type":"any_of","predicates":[
+                {"type":"material","offset":[17,0,0],"allowed":[0]},{"type":"true"}]}},
+            {"type":"count","count":3},{"type":"in_square"},
+            {"type":"environment_scan","direction":1,"max_steps":4,
+             "target_condition":{"type":"material","offset":[0,0,0],"allowed":[0]},
+             "allowed_search_condition":{"type":"material","offset":[0,0,0],"allowed":[2,3]}}
+        ]),
+    ];
+    let mut comparisons = 0;
+    for source in programs {
+        let program: Program = serde_json::from_value(source).unwrap();
+        for origin in [[0i32, 64, 0], [-33, 63, 17], [1_000_000, 128, -1_000_000]] {
+            let (profile, mut field, mut request, mut recipe) = tests::fixture();
+            field.origin_x = origin[0].div_euclid(16) - 1;
+            field.origin_z = origin[2].div_euclid(16) - 1;
+            request.chunk_x = origin[0].div_euclid(16);
+            request.chunk_z = origin[2].div_euclid(16);
+            recipe.placement = Some(program.clone());
+            // Partial ranges cover live-layer continuations; empty ranges also
+            // retain the distinction between clipped and unclipped evaluation.
+            for begin in 0..=program.evaluation.len() {
+                for end in begin..=program.evaluation.len() {
+                    for depth in [0, 1, 2, 5] {
+                        let mut overlay = Overlay::default();
+                        let mut actual_cache = EvaluationCache::default();
+                        let mut reference_cache = EvaluationCache::default();
+                        for child in 0..8 {
+                            let mut order = Order::from_slice(&vec![0; depth]);
+                            if let Some(last) = order.last_mut() {
+                                *last = child;
+                            }
+                            let draws = program.evaluation[begin..end]
+                                .iter()
+                                .filter_map(|step| match program[step.index] {
+                                    Modifier::InSquare
+                                    | Modifier::Offset { .. }
+                                    | Modifier::Cuboid { .. } => Some([child as i32 * 7, 0, 0]),
+                                    Modifier::HeightRange { .. } => {
+                                        Some([0, 60 + child as i32 * 10, 0])
+                                    }
+                                    _ => None,
+                                })
+                                .collect();
+                            let candidate = Candidate {
+                                recipe: 0,
+                                group: 7,
+                                order,
+                                seed: 42,
+                                origin,
+                                draws,
+                                evaluation: begin..end,
+                                layer: None,
+                                stream: None,
+                            };
+                            for clip in [false, true] {
+                                let actual = position_inner(
+                                    &candidate,
+                                    &recipe,
+                                    &field,
+                                    &profile,
+                                    request,
+                                    &overlay,
+                                    &mut actual_cache,
+                                    clip,
+                                );
+                                let expected = position_reference(
+                                    &candidate,
+                                    &recipe,
+                                    &field,
+                                    &profile,
+                                    request,
+                                    &overlay,
+                                    &mut reference_cache,
+                                    clip,
+                                );
+                                assert_eq!(
+                                    actual, expected,
+                                    "range {begin}..{end}, origin {origin:?}, depth {depth}, child {child}"
+                                );
+                                assert_eq!(
+                                    actual_cache, reference_cache,
+                                    "cached parent positions and cached failures must match"
+                                );
+                                comparisons += 1;
+                            }
+                            // Later siblings observe changed live columns except
+                            // where the original parent evaluation was cached.
+                            overlay.write(&profile, [origin[0], 70 + child as i32, origin[2]], 5);
+                            if child % 2 == 1 {
+                                overlay.write(
+                                    &profile,
+                                    [origin[0], 69 + child as i32, origin[2]],
+                                    0,
+                                );
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    assert!(comparisons > 10_000);
+}
+
+fn position_reference(
+    candidate: &Candidate,
+    recipe: &Recipe,
+    field: &Field,
+    profile: &WorldProfile,
+    request: ChunkRequest,
+    overlay: &Overlay,
+    cache: &mut EvaluationCache,
+    clip: bool,
+) -> Option<[i32; 3]> {
+    let mut at = candidate.origin;
+    let program = recipe.placement.as_ref()?;
+    let mut draws = candidate.draws.iter();
+    for Evaluation { index, parents, .. } in &program.evaluation[candidate.evaluation.clone()] {
+        match &program[*index] {
+            Modifier::InSquare | Modifier::Offset { .. } | Modifier::Cuboid { .. } => {
+                let offset = draws.next().unwrap();
+                at = std::array::from_fn(|i| at[i] + offset[i]);
+            }
+            Modifier::HeightRange { .. } => at[1] = draws.next().unwrap()[1],
+            _ => {
+                // Modifiers before a nested count execute once for the parent,
+                // before any of its children place blocks. Later children inherit
+                // that position/filter outcome even as the live canopy changes.
+                let key = (*parents < candidate.order.len()).then(|| {
+                    (
+                        candidate.group,
+                        *index,
+                        Order::from_slice(&candidate.order[..*parents]),
+                    )
+                });
+                if let Some(value) = key.as_ref().and_then(|key| cache.get(key)) {
+                    at = (*value)?;
+                    continue;
+                }
+                let evaluated = (|| {
+                    match &program[*index] {
+                        Modifier::Heightmap { map } => {
+                            at[1] = overlay.height(field, profile, request, at[0], at[2], *map)?;
+                        }
+                        Modifier::BlockPredicateFilter { predicate } => {
+                            if predicate.test(at, field, profile, request, overlay) != Some(true) {
+                                return None;
+                            }
+                        }
+                        Modifier::Biome => {
+                            if !profile.biomes[field.biome(profile, at)?]
+                                .decorations
+                                .contains(&candidate.recipe)
+                            {
+                                return None;
+                            }
+                        }
+                        Modifier::SurfaceWaterDepthFilter { max_water_depth } => {
+                            // Ordinals exported by the game: OCEAN_FLOOR=3, WORLD_SURFACE=1.
+                            if overlay.height(field, profile, request, at[0], at[2], 1)?
+                                - overlay.height(field, profile, request, at[0], at[2], 3)?
+                                > *max_water_depth
+                            {
+                                return None;
+                            }
+                        }
+                        Modifier::SurfaceRelativeThresholdFilter {
+                            map,
+                            min_inclusive,
+                            max_inclusive,
+                        } => {
+                            if !surface_relative(
+                                at,
+                                *map,
+                                *min_inclusive,
+                                *max_inclusive,
+                                field,
+                                profile,
+                                request,
+                                overlay,
+                            ) {
+                                return None;
+                            }
+                        }
+                        Modifier::EnvironmentScan {
+                            direction,
+                            target_condition,
+                            allowed_search_condition,
+                            max_steps,
+                        } => {
+                            at = environment_scan(
+                                at,
+                                *direction,
+                                *max_steps,
+                                target_condition,
+                                allowed_search_condition,
+                                field,
+                                profile,
+                                request,
+                                overlay,
+                            )?;
+                        }
+                        _ => unreachable!(),
+                    }
+                    Some(at)
+                })();
+                if let Some(key) = key {
+                    cache.insert(key, evaluated);
+                }
+                at = evaluated?;
+            }
+        }
+    }
+    (!clip || at[1] >= request.min_y && at[1] < request.min_y + request.height as i32).then_some(at)
+}
