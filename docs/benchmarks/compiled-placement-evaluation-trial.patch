+/// Small hot-path instructions avoid fetching the large registry modifier enum
+/// for every candidate. Complex predicates stay in the immutable source program.
+#[derive(Clone, Copy)]
+enum EvaluationOp {
+    Offset,
+    Height,
+    Heightmap(u8),
+    Accept,
+    Predicate,
+    Biome,
+    WaterDepth(i32),
+    SurfaceRelative { map: u8, min: i32, max: i32 },
+    Scan,
+}
+impl EvaluationOp {
+    fn compile(op: &Modifier) -> Self {
+        match op {
+            Modifier::InSquare | Modifier::Offset { .. } | Modifier::Cuboid { .. } => Self::Offset,
+            Modifier::HeightRange { .. } => Self::Height,
+            Modifier::Heightmap { map } => Self::Heightmap(*map),
+            Modifier::BlockPredicateFilter {
+                predicate: Predicate::True,
+            } => Self::Accept,
+            Modifier::BlockPredicateFilter { .. } => Self::Predicate,
+            Modifier::Biome => Self::Biome,
+            Modifier::SurfaceWaterDepthFilter { max_water_depth } => {
+                Self::WaterDepth(*max_water_depth)
+            }
+            Modifier::SurfaceRelativeThresholdFilter {
+                map,
+                min_inclusive,
+                max_inclusive,
+            } => Self::SurfaceRelative {
+                map: *map,
+                min: *min_inclusive,
+                max: *max_inclusive,
+            },
+            Modifier::EnvironmentScan { .. } => Self::Scan,
+            _ => unreachable!("branch/RNG modifiers are evaluated during expansion"),
+        }
+    }
 }
