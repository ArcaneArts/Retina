+fn group_suspension_preserves_ordered_output_and_bounded_recovery() {
+    let pool = rayon::ThreadPoolBuilder::new().num_threads(2).build().unwrap();
+    for source_order in [false, true] {
+        for (seed, origin) in [(42, 0), (123456789, -33), (987654321, 700_000)] {
+            let (mut profile, field, request) = fixture(seed, origin);
+            // A later group after the live-layer count queries exercises both
+            // count-checkpoint and provider-checkpoint suspension boundaries.
+            let mut tail = profile.decorations[1].clone();
+            tail.source = "test:tail".into();
+            tail.salt = 99;
+            profile.decorations.push(tail);
+            profile.biomes[0].decorations.push(5);
+            profile.decoration_source_order = source_order;
+            for (id, recipe) in profile.decorations.iter_mut().enumerate() {
+                recipe.root_order = id.min(3) as u32;
+            }
+            let (expected, _, _) = pool.install(|| run(&profile, &field, request, false, 0));
+            for budget in [0, 16 * 1024, 64 * 1024 * 1024] {
+                let (actual, details, queries) = pool.install(|| {
+                    run_mode(&profile, &field, request, true, budget, true)
+                });
+                assert_eq!(actual, expected, "seed {seed}, origin {origin}, budget {budget}");
+                assert!(details.worker.suspended_groups > 0);
+                assert!(details.peak_retained_bytes <= budget as u64);
+                assert!(queries.iter().any(|(noise, _)| !noise.is_empty()));
+                assert!(queries.iter().any(|(_, counts)| !counts.is_empty()));
+                if budget == 0 {
+                    assert!(details.worker.discarded_checkpoints > 0);
+                    assert_eq!(details.worker.resumed_anchors, 0);
+                }
+            }
+        }
+    }
+}
+#[test]
