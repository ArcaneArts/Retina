diff --git a/native/src/lighting.wgsl b/native/src/lighting.wgsl
index 68efb4f..53ba9cc 100644
--- a/native/src/lighting.wgsl
+++ b/native/src/lighting.wgsl
@@ -239,0 +240,71 @@ fn nibbles(word: u32) -> u32 {
+
+// Exact six-predicate final heightmaps, independent of light opacity or sky.
+// One invocation owns a column. The material upload and state palette are shared
+// with lighting, and uniform zero-mask sections can be skipped in one step.
+@compute @workgroup_size(64)
+fn final_heights(@builtin(global_invocation_id) id: vec3<u32>) {
+    let column = id.x;
+    if column >= p.core * p.core * 256u { return; }
+    let chunk = column / 256u;
+    let local = column % 256u;
+    let input_chunk = (p.crop + chunk / p.core) * p.chunks + p.crop + chunk % p.core;
+    let height = p.height - 32u;
+    var found = array<u32, 6>(0u, 0u, 0u, 0u, 0u, 0u);
+    var pending = 63u;
+    for (var sy = height / 16u; sy > 0u && pending != 0u; sy--) {
+        if (p.flags & 8u) != 0u {
+            let descriptor = blocks[input_chunk * (height / 16u) + sy - 1u];
+            if (descriptor & 0x80000000u) != 0u {
+                let hit = states[descriptor & 65535u].padding & pending;
+                for (var kind = 0u; kind < 6u; kind++) {
+                    if (hit & (1u << kind)) != 0u { found[kind] = sy * 16u; }
+                }
+                pending &= ~hit;
+                continue;
+            }
+        }
+        for (var dy = sy * 16u; dy > (sy - 1u) * 16u && pending != 0u; dy--) {
+            let block = input_chunk * height * 256u + (dy - 1u) * 256u + local;
+            let material = (material_word(block / 2u) >> ((block % 2u) * 16u)) & 65535u;
+            let hit = states[material].padding & pending;
+            for (var kind = 0u; kind < 6u; kind++) {
+                if (hit & (1u << kind)) != 0u { found[kind] = dy; }
+            }
+            pending &= ~hit;
+        }
+    }
+    for (var kind = 0u; kind < 6u; kind++) {
+        output[p.padding1 + (chunk * 6u + kind) * 256u + local] = found[kind];
+    }
+}
+
+fn big_endian(word: u32) -> u32 {
+    return (word << 24u) | ((word & 0xff00u) << 8u)
+        | ((word >> 8u) & 0xff00u) | (word >> 24u);
+}
+
+// WGSL does not need native u64: Minecraft's non-straddling long packing is
+// constructed as two u32 halves, then written in NBT's big-endian byte order.
+@compute @workgroup_size(64)
+fn pack_heights(@builtin(global_invocation_id) id: vec3<u32>) {
+    let bits = 32u - countLeadingZeros(p.height - 32u);
+    let per_long = 64u / bits;
+    let longs = (256u + per_long - 1u) / per_long;
+    let word = id.x;
+    if word >= p.core * p.core * 6u * longs { return; }
+    let map = word / longs;
+    let first = (word % longs) * per_long;
+    var low = 0u; var high = 0u;
+    for (var i = 0u; i < per_long && first + i < 256u; i++) {
+        let value = output[p.padding1 + map * 256u + first + i];
+        let shift = i * bits;
+        if shift < 32u {
+            low |= value << shift;
+            if shift > 32u - bits { high |= value >> (32u - shift); }
+        } else {
+            high |= value << (shift - 32u);
+        }
+    }
+    output[p.padding2 + word * 2u] = big_endian(high);
+    output[p.padding2 + word * 2u + 1u] = big_endian(low);
+}
diff --git a/native/src/lighting/heightmap_tests.rs b/native/src/lighting/heightmap_tests.rs
new file mode 100644
index 0000000..92b0fdb
--- /dev/null
+++ b/native/src/lighting/heightmap_tests.rs
@@ -0,0 +1,161 @@
+use super::*;
+
+fn expected_maps(blocks: &[u16], states: &[[u32; 8]], height: usize) -> Vec<u8> {
+    let bits = usize::BITS - height.leading_zeros();
+    let per_long = 64 / bits as usize;
+    let mut result = Vec::new();
+    for kind in 0..6 {
+        let heights: Vec<u64> = (0..256)
+            .map(|c| {
+                (0..height)
+                    .rev()
+                    .find(|&y| states[blocks[y * 256 + c] as usize][7] & (1 << kind) != 0)
+                    .map_or(0, |y| (y + 1) as u64)
+            })
+            .collect();
+        for group in heights.chunks(per_long) {
+            let word = group.iter().enumerate().fold(0u64, |word, (i, &value)| {
+                word | value << (i * bits as usize)
+            });
+            result.extend_from_slice(&word.to_be_bytes());
+        }
+    }
+    result
+}
+
+#[test]
+#[ignore = "requires a supported GPU; bounded final-heightmap correctness fixture"]
+fn gpu_final_heightmaps_match_all_predicates_packing_and_lighting() {
+    let engine = crate::TerrainEngine::new().unwrap();
+    let mut gpu = engine.light_gpu.lock().unwrap();
+    let mut flights = Vec::new();
+    for (case, (side, height, crop, core, pattern)) in [
+        (3usize, 16usize, 1usize, 1usize, 0),
+        (3, 80, 0, 3, 1),
+        (4, 256, 1, 2, 2),
+        (3, 384, 1, 1, 3),
+        (2, 512, 0, 2, 4),
+        (3, 32, 1, 1, 5),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let mut profile = tests::fixture_profile(case % 2 == 0);
+        profile.states.resize(65536, [0; 8]);
+        for (id, state) in profile.states.iter_mut().enumerate() {
+            // Include all predicate combinations and unrelated lighting traits.
+            state[7] = (id as u32) & 63;
+            state[0] = if id % 7 == 0 { 0 } else { 15 };
+        }
+        if pattern == 5 {
+            profile.states[0][7] = 63;
+        }
+        let mut blocks = vec![0u16; side * side * height * 256];
+        for (i, value) in blocks.iter_mut().enumerate() {
+            let y = (i / 256) % height;
+            let c = i % 256;
+            *value = match pattern {
+                0 => 0,
+                1 => 65535,
+                2 if y < 16 => 63,
+                2 if y < height - 16 => (1 << ((y / 16) % 6)) as u16,
+                2 => 0,
+                3 if y == (c * 71 + i / (height * 256)) % height => 65535,
+                3 => 0,
+                4 if y == 0 || y == height - 1 => 1 << (c % 6),
+                4 if y < height / 2 => ((i * 17 + i / 4096) % 63 + 1) as u16,
+                _ => 0,
+            };
+        }
+        let handle = 600 + case as u32;
+        gpu.compact_input = false;
+        let expected_light = gpu
+            .run(
+                handle,
+                &profile,
+                side as u32,
+                height as u32,
+                crop as u32,
+                core as u32,
+                &blocks,
+                OutputFormat::Sections,
+            )
+            .unwrap()
+            .bytes;
+        let indices: Vec<_> = (0..core)
+            .flat_map(|z| (0..core).map(move |x| (crop + z) * side + crop + x))
+            .collect();
+        let expected: Vec<_> = indices
+            .iter()
+            .map(|&i| {
+                expected_maps(
+                    &blocks[i * height * 256..(i + 1) * height * 256],
+                    &profile.states,
+                    height,
+                )
+            })
+            .collect();
+        let metadata: Vec<_> = blocks
+            .chunks_exact(height * 256)
+            .map(transport::classify)
+            .collect();
+        let constants = output::Constants::new(&profile, &metadata, side);
+        for compact in [false, true] {
+            let mut packed = Vec::new();
+            let payload = if compact {
+                transport::pack(
+                    &mut packed,
+                    blocks
+                        .chunks_exact(height * 256)
+                        .zip(metadata.iter().map(Vec::as_slice)),
+                    height as u32,
+                );
+                bytemuck::cast_slice(&packed)
+            } else {
+                bytemuck::cast_slice(&blocks)
+            };
+            let layout = compact.then(|| constants.tile(indices.iter().copied()));
+            let pending = gpu
+                .submit_payload(
+                    handle,
+                    &profile,
+                    side as u32,
+                    height as u32,
+                    crop as u32,
+                    core as u32,
+                    payload,
+                    compact,
+                    OutputFormat::Sections,
+                    layout,
+                    true,
+                )
+                .unwrap();
+            flights.push((pending, expected_light.clone(), expected.clone(), height));
+        }
+        // Complete in reverse order after buffers have been reused and resized.
+        if flights.len() >= 4 {
+            for (pending, light, maps, height) in flights.drain(..).rev() {
+                let result = gpu.complete(pending).unwrap();
+                let tile = Tile {
+                    slots: Vec::new(),
+                    bytes: result.bytes,
+                    chunk_bytes: (height + 32) * 256,
+                    layout: result.layout,
+                    heightmaps: result.heightmaps,
+                };
+                let actual_light: Vec<_> = (0..maps.len())
+                    .flat_map(|i| tile.chunk(i).expanded(height / 16 + 2))
+                    .collect();
+                assert_eq!(actual_light, light, "lighting changed in case {case}");
+                for (i, expected) in maps.iter().enumerate() {
+                    assert_eq!(
+                        tile.chunk(i).heightmaps.unwrap(),
+                        expected,
+                        "heightmaps case {case} chunk {i}"
+                    );
+                }
+            }
+        }
+    }
+    assert!(flights.is_empty());
+}
