@@ -232,0 +239,116 @@ fn gpu_vine_registered_planner() {
+
+fn guarded_field(profile: &WorldProfile, request: ChunkRequest) -> Field {
+    let wide = super::super::anchor_probe::vine_field(profile, 5, 6, request, 3);
+    let side = wide.side - 2;
+    let columns = (1..=side)
+        .flat_map(|z| {
+            let start = (z * wide.side + 1) * COLUMNS;
+            wide.columns[start..start + side * COLUMNS].iter().copied()
+        })
+        .collect();
+    let mut substrate = Arc::try_unwrap(wide.substrate.unwrap()).ok().unwrap();
+    substrate.columns = Some(crate::geology::ColumnHalo {
+        origin_x: wide.origin_x,
+        origin_z: wide.origin_z,
+        side: wide.side,
+        columns: Arc::new(wide.columns),
+    });
+    Field {
+        origin_x: wide.origin_x + 1,
+        origin_z: wide.origin_z + 1,
+        side,
+        columns,
+        substrate: Some(Arc::new(substrate)),
+    }
+}
+
+fn horizontal_predicate(profile: &mut WorldProfile, offset: i32) {
+    let mut ops = profile.decorations[5].placement.as_ref().unwrap().to_vec();
+    ops[4] = Modifier::BlockPredicateFilter {
+        predicate: serde_json::from_value(json!({
+            "type":"material", "offset":[-offset,0,0], "allowed":[1]
+        }))
+        .unwrap(),
+    };
+    profile.decorations[5].placement = Some(ops.into());
+}
+
+#[test]
+fn vine_input_uses_only_available_quart_aligned_program_guards() {
+    let (mut p, r) = fixture();
+    let field = guarded_field(&p, r);
+    for radius in [0, 1, 4, 5, 16, 17, 32] {
+        horizontal_predicate(&mut p, radius);
+        let programs = compile(&p, r);
+        let program = programs[5].as_ref().unwrap();
+        assert_eq!(program.horizontal_margin, radius as u32);
+        let input = Input::new(&field, &p, r, 5, program, None).unwrap();
+        let margin = (radius as u32).div_ceil(4).min(4) * 4;
+        assert_eq!(input.words[2], field.side as u32 * 16 + margin * 2);
+        assert_eq!(input.words[0] as i32, field.origin_x * 16 - margin as i32);
+        assert_eq!(input.words[1] as i32, field.origin_z * 16 - margin as i32);
+        assert_eq!(input.words[0] as i32 % 4, 0);
+        // Earlier feature writes in the newly included guard must remain in
+        // the anchor overlay and override the immutable base material.
+        let mut overlay = Overlay::default();
+        if margin > 0 {
+            overlay.write(&p, [field.origin_x * 16 - 1, 70, field.origin_z * 16], 6);
+            let anchors = input.anchors(r, program, &[(r.chunk_x, r.chunk_z, &overlay)]);
+            assert_eq!(anchors[9], 1);
+            assert_eq!(anchors[anchors[8] as usize + 1], 6);
+        }
+    }
+}
+
+#[test]
+#[ignore = "bounded Metal existing guard columns and unknown-input fallback correctness"]
+fn gpu_vine_guard_columns() {
+    let engine = crate::TerrainEngine::new().unwrap();
+    let (device, queue) = engine.ore_gpu.lock().unwrap().shared_device();
+    let mut gpu = Gpu::new(device, queue, engine.backend());
+    gpu.enable_for_test(true);
+    let gpu = Mutex::new(gpu);
+    let pool = rayon::ThreadPoolBuilder::new()
+        .num_threads(2)
+        .build()
+        .unwrap();
+    for origin in [0, -17, 1_000_000] {
+        for (radius, guard, needs_fallback) in
+            [(1, true, false), (1, false, true), (32, true, true)]
+        {
+            let (mut p, mut r) = fixture();
+            horizontal_predicate(&mut p, radius);
+            r.chunk_x = origin;
+            r.chunk_z = -origin;
+            let field = if guard {
+                let field = guarded_field(&p, r);
+                r.chunk_x += 1;
+                r.chunk_z += 1;
+                field
+            } else {
+                super::super::anchor_probe::vine_field(&p, 5, 6, r, 1)
+            };
+            let (expected, _, _) = pool.install(|| replay(&p, &field, r, None, 64 << 20, None));
+            let (actual, stats, _) =
+                pool.install(|| replay(&p, &field, r, Some(&gpu), 64 << 20, None));
+            assert_eq!(
+                actual, expected,
+                "origin {origin}, radius {radius}, guard {guard}"
+            );
+            assert!(stats.anchors > 0);
+            assert_eq!(
+                stats.unresolved_material_anchors > 0,
+                needs_fallback,
+                "{stats:?}"
+            );
+            assert_eq!(
+                stats.overflow_anchors, 0,
+                "missing material is not capacity overflow"
+            );
+            assert_eq!(stats.incomplete_candidate_anchors, 0);
+            if !needs_fallback {
+                assert_eq!(stats.fallbacks, 0);
+            }
+        }
+    }
+}
