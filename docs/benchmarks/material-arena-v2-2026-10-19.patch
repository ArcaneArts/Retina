+//! Exact fast-path/overflow and asynchronous ownership checks on real GPU inputs.
+use super::material_continuation_tests::{equal, fixture, request};
+use super::*;
+
+#[test]
+#[ignore = "bounded real GPU arena fixtures; requires RETINA_MATERIAL_PROFILE"]
+fn material_arena_preserves_fast_overflow_interleaving_and_reuse() {
+    let profile = fixture();
+    let mut other = profile.clone();
+    other.sea_level -= 17;
+    let metrics = std::sync::Arc::new(crate::pipeline::Metrics::default());
+    let mut gpu = Gpu::new(metrics.clone()).unwrap();
+    let times = timings::Timings::default();
+    let a = request(1, -33, 3, 128);
+    let b = request(2, 4095, 5, 192);
+    let selected = |r: GpuRequest| if r.profile == 2 { &other } else { &profile };
+    let mut expected = Vec::new();
+    gpu.material_arena_runs = 0;
+    for r in [a, b] {
+        let p = gpu.submit(&[r], Some(selected(r)), &times).unwrap();
+        expected.push(gpu.complete(p, &times).unwrap());
+    }
+    // Every flight owns its readbacks and fallback snapshots while the shared
+    // arena is overwritten by later submissions. Finish all eight in reverse.
+    gpu.material_arena_runs = 64;
+    let before = metrics.material_snapshot();
+    let mut flights = Vec::new();
+    for r in [a, b, a, b, a, b, a, b] {
+        let p = gpu.submit(&[r], Some(selected(r)), &times).unwrap();
+        flights.push((r, p));
+    }
+    for (r, p) in flights.into_iter().rev() {
+        let Progress::Complete(result) = gpu.advance(p, &times).unwrap() else {
+            panic!("fitting arena must complete without a host continuation");
+        };
+        equal(&expected[usize::from(r.profile == 2)], &result);
+    }
+    let after = metrics.material_snapshot();
+    assert_eq!(
+        after.values[MaterialMetric::ArenaHits as usize]
+            - before.values[MaterialMetric::ArenaHits as usize],
+        8
+    );
+    assert_eq!(
+        after.values[MaterialMetric::Continuations as usize],
+        before.values[MaterialMetric::Continuations as usize]
+    );
+    // A global arena can fit even when individual columns exceed their saved
+    // first-pass quota. Only those columns must be evaluated a second time.
+    let mut exercised = false;
+    for (i, r) in [a, b].into_iter().enumerate() {
+        let mask = expected[i].mask.as_ref().unwrap();
+        let side = mask.width - 2;
+        let budget = mask.material_run_count().unwrap().div_ceil(side * side);
+        let max_column = (0..side)
+            .flat_map(|z| {
+                (0..side).map(move |x| {
+                    mask.material_runs(mask.origin_x + 1 + x as i32, mask.origin_z + 1 + z as i32)
+                        .unwrap()
+                        .len()
+                })
+            })
+            .max()
+            .unwrap();
+        if max_column > budget {
+            gpu.material_arena_runs = budget as u32;
+            let p = gpu.submit(&[r], Some(selected(r)), &times).unwrap();
+            let Progress::Complete(result) = gpu.advance(p, &times).unwrap() else {
+                panic!("fitting total must not need a host continuation");
+            };
+            equal(&expected[i], &result);
+            exercised = true;
+        }
+    }
+    assert!(exercised, "fixture must cover per-column staging overflow");
+    // One slot per column cannot fit these material stacks. The failed attempt
+    // must retain exact counts, fluid planes, profile and private job inputs.
+    gpu.material_arena_runs = 1;
+    let first = gpu.submit(&[a], Some(&profile), &times).unwrap();
+    let second = gpu.submit(&[b], Some(&other), &times).unwrap();
+    let Progress::Pending(first) = gpu.advance(first, &times).unwrap() else {
+        panic!("expected overflow");
+    };
+    let Progress::Pending(second) = gpu.advance(second, &times).unwrap() else {
+        panic!("expected overflow");
+    };
+    equal(&expected[1], &gpu.complete(second, &times).unwrap());
+    equal(&expected[0], &gpu.complete(first, &times).unwrap());
+    // Large retained storage must not turn a subsequent smaller logical arena
+    // into a partial success, or include old words in a fitting result.
+    for (r, budget) in [(b, 64), (a, 1), (a, 64), (b, 1)] {
+        gpu.material_arena_runs = budget;
+        let p = gpu.submit(&[r], Some(selected(r)), &times).unwrap();
+        equal(
+            &expected[usize::from(r.profile == 2)],
+            &gpu.complete(p, &times).unwrap(),
+        );
+    }
+    gpu.material_arena_runs = 64;
+    drop(gpu.submit(&[a], Some(&profile), &times).unwrap());
+    gpu.material_arena_runs = 1;
+    let p = gpu.submit(&[b], Some(&other), &times).unwrap();
+    let Progress::Pending(p) = gpu.advance(p, &times).unwrap() else {
+        panic!("expected overflow");
+    };
+    drop(p);
+    gpu.material_arena_runs = 64;
+    gpu.timestamp_support = false;
+    gpu.readback_pool.clear();
+    gpu.material_pool.clear();
+    let p = gpu.submit(&[a], Some(&profile), &times).unwrap();
+    let result = gpu.complete(p, &times).unwrap();
+    equal(&expected[0], &result);
+    assert_eq!(result.timings.flags, 0);
+    assert!(gpu.readback_pool.len() <= 2 && gpu.material_pool.len() <= 2);
+}
+
+#[test]
+#[ignore = "bounded arena timing experiment; requires RETINA_MATERIAL_PROFILE"]
+fn material_arena_replay() {
+    let profile = fixture();
+    let metrics = std::sync::Arc::new(crate::pipeline::Metrics::default());
+    let mut gpu = Gpu::new(metrics.clone()).unwrap();
+    let times = timings::Timings::default();
+    let requests = [request(1, -33, 8, 192), request(1, 4095, 8, 192)];
+    let mut run = |budget| {
+        gpu.material_arena_runs = budget;
+        let start = Instant::now();
+        let first = gpu.submit(&[requests[0]], Some(&profile), &times).unwrap();
+        let second = gpu.submit(&[requests[1]], Some(&profile), &times).unwrap();
+        let first = gpu.advance(first, &times).unwrap();
+        let second = gpu.advance(second, &times).unwrap();
+        let mut finish = |result| match result {
+            Progress::Complete(sample) => sample,
+            Progress::Pending(p) => gpu.complete(p, &times).unwrap(),
+        };
+        let results = [finish(first), finish(second)];
+        (start.elapsed().as_secs_f64() * 1000., results)
+    };
+    let (_, expected) = run(0);
+    let mut measurements = Vec::new();
+    for round in 0..3 {
+        for budget in if round % 2 == 0 { [0, 16] } else { [16, 0] } {
+            let before = metrics.material_snapshot();
+            let (ms, output) = run(budget);
+            for (a, b) in expected.iter().zip(&output) {
+                equal(a, b);
+            }
+            let after = metrics.material_snapshot();
+            measurements.push(serde_json::json!({"runs_per_column":budget,"ms":ms,
+                "counters": std::array::from_fn::<_,9,_>(|i| after.values[i].saturating_sub(before.values[i]))}));
+        }
+    }
+    println!(
+        "{}",
+        serde_json::json!({"measurements":measurements,"exact":true,
+        "run_counts":expected.iter().map(|s|s.mask.as_ref().unwrap().material_run_count()).collect::<Vec<_>>(),
+        "peak_cached_buffer_bytes":metrics.material_snapshot().values[8]})
+    );
+}
