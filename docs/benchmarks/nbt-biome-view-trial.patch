diff --git a/native/src/region/biomes.rs b/native/src/region/biomes.rs
new file mode 100644
index 0000000..df2f68d
--- /dev/null
+++ b/native/src/region/biomes.rs
@@ -0,0 +1,104 @@
+//! Immutable quart-biome addressing prepared once for an encoded chunk.
+use crate::{ChunkRequest, geology::CaveMask, profile::Column};
+
+pub(super) struct ChunkBiomes<'a> {
+    mask: Option<&'a CaveMask>,
+    x: i32,
+    z: i32,
+    surface: [u16; 16],
+    packed: Option<Packed<'a>>,
+}
+
+struct Packed<'a> {
+    words: &'a [u32],
+    offset: usize,
+    width: usize,
+    row: usize,
+    min_y: i64,
+    layers: usize,
+}
+
+impl<'a> ChunkBiomes<'a> {
+    pub fn new(request: ChunkRequest, columns: &[Column], mask: Option<&'a CaveMask>) -> Self {
+        let x = request.chunk_x * 16;
+        let z = request.chunk_z * 16;
+        let surface = std::array::from_fn(|i| columns[i / 4 * 64 + i % 4 * 4].biome() as u16);
+        let packed = mask.and_then(|mask| {
+            let side = mask.width + 30;
+            let width = side / 4;
+            let dx = i64::from(x) - (i64::from(mask.origin_x) - 15);
+            let dz = i64::from(z) - (i64::from(mask.origin_z) - 15);
+            if dx < 0
+                || dz < 0
+                || dx + 12 >= side as i64
+                || dz + 12 >= side as i64
+                || dx / 4 + 3 >= width as i64
+                || dz / 4 + 3 >= width as i64
+            {
+                return None;
+            }
+            let min_y = i64::from(mask.min_y.div_euclid(4)) * 4;
+            Some(Packed {
+                words: &mask.words,
+                offset: (mask.width * mask.width * mask.height as usize).div_ceil(32)
+                    + (side * side).div_ceil(32),
+                width,
+                row: dz as usize / 4 * width + dx as usize / 4,
+                min_y,
+                layers: ((i64::from(mask.min_y) + i64::from(mask.height) - min_y + 3) / 4) as usize,
+            })
+        });
+        Self {
+            mask,
+            x,
+            z,
+            surface,
+            packed,
+        }
+    }
+
+    pub fn section(&self, y: i32) -> [u16; 64] {
+        if let Some(packed) = &self.packed {
+            let dy = i64::from(y) - packed.min_y;
+            if dy >= 0 && dy as usize / 4 + 3 < packed.layers {
+                let plane = packed.width * packed.width;
+                let start = dy as usize / 4 * plane + packed.row;
+                let mut values = [0; 64];
+                for layer in 0..4 {
+                    for row in 0..4 {
+                        let index = start + layer * plane + row * packed.width;
+                        let words = &packed.words[packed.offset + index / 2..];
+                        let out = &mut values[layer * 16 + row * 4..][..4];
+                        if index & 1 == 0 {
+                            out.copy_from_slice(&[
+                                words[0] as u16,
+                                (words[0] >> 16) as u16,
+                                words[1] as u16,
+                                (words[1] >> 16) as u16,
+                            ]);
+                        } else {
+                            out.copy_from_slice(&[
+                                (words[0] >> 16) as u16,
+                                words[1] as u16,
+                                (words[1] >> 16) as u16,
+                                words[2] as u16,
+                            ]);
+                        }
+                    }
+                }
+                return values;
+            }
+        }
+        std::array::from_fn(|i| {
+            self.mask
+                .and_then(|mask| {
+                    mask.biome(
+                        self.x + (i % 4) as i32 * 4,
+                        y + (i / 16) as i32 * 4,
+                        self.z + (i / 4 % 4) as i32 * 4,
+                    )
+                })
+                .unwrap_or(self.surface[i % 16])
+        })
+    }
+}
