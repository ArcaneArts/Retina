    "enabled_counter_backing_bytes": 73728,
    "disabled_counter_backing_bytes": 0,
    "memory_scope": "Counter backing only; excludes allocator bookkeeping and unchanged candidate/terrain tracking.",
    "snapshot_scope": "Shards are read sequentially. Totals are exact modulo u64 after writers join; live snapshots are not one instant across writers.",
    "snapshot_cost": "The isolated joined array-read benchmark rises from about 61\u201376 ns to 1.30\u20131.35 us. It includes Vec creation/drop and excludes JSON/Seen scans.",
    "unchanged_scope": "Generation ordering, RNG, feature/structure selection, dependency closure, terrain coverage, cache lifetimes and worker scheduling are unchanged."
  },
