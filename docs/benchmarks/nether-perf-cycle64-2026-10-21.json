  "design_review": {
    "status": "source review; validation in progress",
    "source_revision": "c2a61d933f33a5680ad02e38a5b39d83f5e08275",
    "native_tree": "149348d8e70c512d42ff943bcdc88a3a294c9792",
    "accepted_baseline": "60e210d1b0e459955aec2007d8231ee4358bed88",
    "scope": "C62/C63 exact cooperative queue/scoped helpers plus nonblocking optional queued-key claims. Earlier prototypes remain held; their production foundation is not an accepted baseline.",
    "invariants": [
      "Only an EMPTY->BUILDING CAS owns initialization. Both APIs use the same OnceLock publication, Owner panic guard and Active ancestor guard. try_get_or_init never marks WAITING or blocks on the existing initializer.",
      "A racing publication may be returned by the post-CAS-failure get; a still-owned or just-abandoned cell returns None. Skipping is allowed because every queued descriptor originated from a required consumer which still resolves it.",
      "Once a helper owns a key it performs the entire original build, with required lower-level waits. No Pending state enters feature evaluation and no feature replay or truncated dependency closure is added.",
      "Ready errors and newly built errors propagate their original string through Planner.fail. Scope joins all helpers before check, publication and cleanup.",
      "Each helper claim class is recorded at the actual queued key; recursive calls remain ordinary. Ready and owned include failed results, busy is a skipped optional call, attempts also include lookup failures, and drained only counts successful ready/owned resolutions.",
      "Bounded queue4096, permits<=existing pool threads, 32-writer temporary batches, source order, same-job inherited ancestor restriction, job identity isolation and joined cleanup are unchanged."
    ],
    "tests_added": [
      "Busy BUILDING and WAITING calls return before owner release and never invoke optional initializer or change waiting bit.",
      "8-thread mixed required/optional races repeated32 for both success and cached error: exactly one build, exact cached value/error.",
      "Optional panic resets claim and TLS then retries successfully; existing contended panic test now exercises both optional and required owner.",
      "Drain skips an owned key and finishes another dependency before owner is released; owned key still completes.",
      "Existing idle-worker and 1/2-worker scope fixtures now use try_get_or_init for optional work. Panic TLS cleanup is checked on every pool worker via broadcast."
    ],
    "limits": [
      "Known host load; quiet timing confirmation deferred by user. Do not claim an accepted speedup from loaded measurements.",
      "Busy-key avoidance does not eliminate required dependency waits or global notification broadcasts.",
      "Descriptor/task counts are not CPU utilization, build counts or wall-time fractions. Observer helper success means no error; a busy skipped attempt is not a built anchor."
    ]
  },
