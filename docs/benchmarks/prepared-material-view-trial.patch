+//! Immutable field-local view of packed material runs. The Arc remains private:
+//! prepared offsets cannot outlive or be invalidated by mutable backing words.
+use super::CaveMask;
+use std::{cell::Cell, ops::Deref, sync::Arc};
+
+#[derive(Clone)]
+pub struct Substrate {
+    mask: Arc<CaveMask>,
+    layout: Option<Layout>,
+}
+#[derive(Clone, Copy)]
+struct Layout {
+    width: usize,
+    entries: usize,
+    groups: usize,
+    runs: usize,
+}
+#[derive(Clone, Copy)]
+pub(crate) struct Column<'a> {
+    runs: &'a [u32],
+    min_y: i32,
+    height: u32,
+}
+impl From<Arc<CaveMask>> for Substrate {
+    fn from(mask: Arc<CaveMask>) -> Self {
+        let at = mask.base_words();
+        let layout = mask
+            .words
+            .get(at..at + 4)
+            .filter(|v| v[0] == 0x52554e53)
+            .map(|v| {
+                let width = v[1] as usize;
+                let count = width * width;
+                let groups = count.div_ceil(256);
+                Layout {
+                    width,
+                    entries: at + 4,
+                    groups: at + 4 + count * 2 + groups,
+                    runs: at + 4 + count * 2 + groups * 2,
+                }
+            });
+        Self { mask, layout }
+    }
+}
+impl Deref for Substrate {
+    type Target = CaveMask;
+    fn deref(&self) -> &CaveMask {
+        &self.mask
+    }
+}
+impl Substrate {
+    #[inline]
+    pub(crate) fn material_runs(&self, x: i32, z: i32) -> Option<&[u32]> {
+        let layout = self.layout?;
+        let x = x as i64 - (self.mask.origin_x as i64 + 1);
+        let z = z as i64 - (self.mask.origin_z as i64 + 1);
+        if x < 0 || z < 0 || x as usize >= layout.width || z as usize >= layout.width {
+            return None;
+        }
+        let index = z as usize * layout.width + x as usize;
+        let words = &self.mask.words;
+        let length = words[layout.entries + index * 2] as usize;
+        let start = layout.runs
+            + words[layout.entries + index * 2 + 1] as usize
+            + words[layout.groups + index / 256] as usize;
+        words.get(start..start + length)
+    }
+    #[inline]
+    pub(crate) fn column(&self, x: i32, z: i32) -> Option<Column<'_>> {
+        self.material_runs(x, z).map(|runs| Column {
+            runs,
+            min_y: self.mask.min_y,
+            height: self.mask.height,
+        })
+    }
+    pub(crate) fn material_at(&self, x: i32, y: i32, z: i32) -> Option<u16> {
+        self.column(x, z)?.at(y)
+    }
+    pub(crate) fn height_at(&self, x: i32, z: i32, masks: &[u8], map: u8) -> Option<i32> {
+        self.column(x, z)?.height(masks, map)
+    }
+    pub(crate) fn lookup(&self) -> Lookup<'_> {
+        Lookup {
+            substrate: self,
+            last: Cell::new(None),
+        }
+    }
+}
+impl Column<'_> {
+    #[inline]
+    pub(crate) fn at(&self, y: i32) -> Option<u16> {
+        let y = y as i64 - self.min_y as i64;
+        if y < 0 || y >= self.height as i64 {
+            return Some(0);
+        }
+        let index = self.runs.partition_point(|run| run >> 16 > y as u32);
+        self.runs.get(index).map(|run| *run as u16)
+    }
+    pub(crate) fn height(&self, masks: &[u8], map: u8) -> Option<i32> {
+        let bit = 1u8.checked_shl(map as u32)?;
+        let mut top = self.min_y + self.height as i32;
+        for run in self.runs {
+            if masks.get(*run as u16 as usize)? & bit != 0 {
+                return Some(top);
+            }
+            top = self.min_y + (run >> 16) as i32;
+        }
+        Some(self.min_y)
+    }
+}
+/// Short-lived read-only scan cache. Only the base column is memoized; callers
+/// still check the live overlay first for every queried block.
+pub(crate) struct Lookup<'a> {
+    substrate: &'a Substrate,
+    last: Cell<Option<([i32; 2], Option<Column<'a>>)>>,
+}
+impl Lookup<'_> {
+    pub(crate) fn material(&self, at: [i32; 3]) -> Option<u16> {
+        let key = [at[0], at[2]];
+        let column = match self.last.get() {
+            Some((old, column)) if old == key => column,
+            _ => {
+                let column = self.substrate.column(at[0], at[2]);
+                self.last.set(Some((key, column)));
+                column
+            }
+        };
+        column?.at(at[1])
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture(origin: i32, min_y: i32) -> Arc<CaveMask> {
+        let mut mask = CaveMask {
+            origin_x: origin,
+            origin_z: -origin,
+            min_y,
+            height: 128,
+            width: 34,
+            air_only: true,
+            words: vec![],
+            columns: None,
+        };
+        let at = mask.base_words();
+        let count = 32usize.pow(2);
+        let groups = count.div_ceil(256);
+        mask.words.resize(at + 4 + count * 2 + groups * 2, 0);
+        mask.words[at..at + 4].copy_from_slice(&[0x52554e53, 32, count as u32, count as u32 * 4]);
+        for index in 0..count {
+            mask.words[at + 4 + index * 2] = 4;
+            mask.words[at + 5 + index * 2] = (index % 256 * 4) as u32;
+            mask.words.extend([112 << 16, 80 << 16 | 3, 5 << 16 | 2, 1]);
+        }
+        for group in 0..groups {
+            mask.words[at + 4 + count * 2 + groups + group] = (group * 256 * 4) as u32;
+        }
+        mask.validate_material_runs().unwrap();
+        Arc::new(mask)
+    }
+    #[test]
+    fn prepared_columns_match_raw_runs_materials_and_all_heightmaps() {
+        for (origin, min_y) in [(-30000000, -62), (30000000, -64), (-17, 0)] {
+            let mask = fixture(origin, min_y);
+            let substrate: Substrate = mask.clone().into();
+            let lookup = substrate.lookup();
+            for dz in 0..34 {
+                for dx in 0..34 {
+                    let (x, z) = (origin + dx, -origin + dz);
+                    assert_eq!(substrate.material_runs(x, z), mask.material_runs(x, z));
+                    for y in min_y - 1..=min_y + 128 {
+                        let expected = mask.material_at(x, y, z);
+                        assert_eq!(substrate.material_at(x, y, z), expected);
+                        assert_eq!(lookup.material([x, y, z]), expected);
+                    }
+                    for map in 0..=6 {
+                        assert_eq!(
+                            substrate.height_at(x, z, &[0, 1, 3, 63], map),
+                            mask.height_at(x, z, &[0, 1, 3, 63], map)
+                        );
+                    }
+                }
+            }
+            assert_eq!(substrate.material_at(i32::MIN, min_y, i32::MAX), None);
+            assert_eq!(
+                substrate.material_at(origin + 1, i32::MIN, -origin + 1),
+                Some(0)
+            );
+            // Holding the prepared view prevents mutable access to its Arc data.
+            let mut owner = mask;
+            assert!(Arc::get_mut(&mut owner).is_none());
+        }
+        let mut missing = fixture(0, -64);
+        Arc::get_mut(&mut missing).unwrap().words.clear();
+        let missing: Substrate = missing.into();
+        assert_eq!(missing.material_at(1, 0, 1), None);
+        assert_eq!(missing.height_at(1, 1, &[0, 1], 1), None);
+    }
+    #[test]
+    #[ignore = "bounded prepared material lookup microbenchmark"]
+    fn prepared_material_lookup_benchmark() {
+        use std::{hint::black_box, time::Instant};
+        let mask = fixture(-30000, -62);
+        let substrate: Substrate = mask.clone().into();
+        let queries: Vec<_> = (0..32)
+            .flat_map(|z| {
+                (0..32).flat_map(move |x| {
+                    (-64..68)
+                        .step_by(3)
+                        .map(move |y| [-29999 + x, y, 30001 + z])
+                })
+            })
+            .collect();
+        let mut raw = Vec::new();
+        let mut prepared = Vec::new();
+        let mut cached = Vec::new();
+        let mut expected = None;
+        for round in 0..25 {
+            for shift in 0..3 {
+                let mode = (round + shift) % 3;
+                let lookup = substrate.lookup();
+                let start = Instant::now();
+                let mut sum = 0u64;
+                for _ in 0..4 {
+                    for &at in black_box(&queries) {
+                        let material = match mode {
+                            0 => black_box(&*mask).material_at(at[0], at[1], at[2]),
+                            1 => black_box(&substrate).material_at(at[0], at[1], at[2]),
+                            _ => black_box(&lookup).material(at),
+                        };
+                        sum += black_box(material).map_or(65536, u64::from);
+                    }
+                }
+                let ms = start.elapsed().as_secs_f64() * 1000.;
+                if let Some(e) = expected {
+                    assert_eq!(sum, e);
+                } else {
+                    expected = Some(sum);
+                }
+                if round >= 5 {
+                    match mode {
+                        0 => raw.push(ms),
+                        1 => prepared.push(ms),
+                        _ => cached.push(ms),
+                    }
+                }
+            }
+        }
+        println!(
+            "PREPARED_MATERIAL_LOOKUPS {}",
+            serde_json::json!({"warmups":5,"iterations":20,
+            "queries":queries.len()*4,"checksum":expected,"raw_ms":raw,"prepared_ms":prepared,"cached_ms":cached})
+        );
+    }
+}
