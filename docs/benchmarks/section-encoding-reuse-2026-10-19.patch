+use super::*;
+use crate::geology::CaveMask;
+use std::hint::black_box;
+
+fn mask(min_y: i32, height: u32, origin_x: i32, origin_z: i32) -> CaveMask {
+    let width: usize = 34;
+    let surface = width + 30;
+    let q = surface / 4;
+    let layers = ((min_y + height as i32 - min_y.div_euclid(4) * 4 + 3) / 4) as usize;
+    let offset = (width * width * height as usize).div_ceil(32) + (surface * surface).div_ceil(32);
+    let count = layers * q * q;
+    let mut words = vec![0; offset + count.div_ceil(2)];
+    for i in 0..count {
+        // Vary x/z/y separately and use both halves of each packed word.
+        let id = ((i * 13 + i / q * 17 + i / (q * q) * 23) % 3) as u32;
+        words[offset + i / 2] |= id << ((i % 2) * 16);
+    }
+    CaveMask {
+        origin_x,
+        origin_z,
+        min_y,
+        height,
+        width,
+        air_only: true,
+        words,
+        columns: None,
+    }
+}
+
+#[test]
+fn bulk_biomes_match_scalar_quarts_and_partial_coverage() {
+    for min_y in [-65, -64, -63, 1, 2, 3] {
+        let m = mask(min_y, 47, -30_000_001, 29_999_983);
+        for dx in [-1, 0, 1, 3, 4, 17, 47, 51, 52, 56, 63, 64] {
+            for dz in [-1, 0, 1, 3, 4, 17, 47, 51, 52, 56, 63, 64] {
+                for dy in [-5, -1, 0, 1, 4, 12, 32, 35, 36, 40, 47, 48] {
+                    let (x, y, z) = (m.origin_x - 15 + dx, min_y + dy, m.origin_z - 15 + dz);
+                    let reference: Option<Vec<_>> = (0..64)
+                        .map(|i| m.biome(x + (i % 4) * 4, y + (i / 16) * 4, z + (i / 4 % 4) * 4))
+                        .collect();
+                    assert_eq!(
+                        m.biome_section(x, y, z).as_ref().map(|a| a.as_slice()),
+                        reference.as_deref(),
+                        "{min_y}: {dx},{dy},{dz}"
+                    );
+                }
+            }
+        }
+    }
+}
