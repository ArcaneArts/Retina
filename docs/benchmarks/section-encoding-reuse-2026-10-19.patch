+    /// Fetch one section's 4x4x4 biome samples in Minecraft x,z,y order.
+    /// Whole-section bounds and packed-plane offsets are invariant across all
+    /// 64 samples. Partial coverage retains the scalar caller's fallback.
+    pub(crate) fn biome_section(&self, x: i32, y: i32, z: i32) -> Option<[u16; 64]> {
+        let surface = self.width + 30;
+        let width = surface / 4;
+        let x = i64::from(x) - (i64::from(self.origin_x) - 15);
+        let z = i64::from(z) - (i64::from(self.origin_z) - 15);
+        let base_y = i64::from(self.min_y.div_euclid(4)) * 4;
+        let y = i64::from(y) - base_y;
+        let layers = (i64::from(self.min_y) + i64::from(self.height) - base_y + 3) / 4;
+        if x < 0
+            || z < 0
+            || y < 0
+            || x + 12 >= surface as i64
+            || z + 12 >= surface as i64
+            || (x / 4 + 3) >= width as i64
+            || (z / 4 + 3) >= width as i64
+            || y / 4 + 3 >= layers
+        {
+            return None;
+        }
+        let offset = (self.width * self.width * self.height as usize).div_ceil(32)
+            + (surface * surface).div_ceil(32);
+        let start = (y as usize / 4 * width + z as usize / 4) * width + x as usize / 4;
+        let mut values = [0u16; 64];
+        for dy in 0..4 {
+            for dz in 0..4 {
+                let row = start + dy * width * width + dz * width;
+                for dx in 0..4 {
+                    let i = row + dx;
+                    values[dy * 16 + dz * 4 + dx] =
+                        (self.words[offset + i / 2] >> ((i % 2) * 16)) as u16;
+                }
+            }
+        }
+        Some(values)
+    }
