+#[test]
+fn reused_sections_preserve_complete_nbt_and_scratch_reuse() {
+    let (profile, request, columns, mut blocks, mask, mut summary) = fixture();
+    let partial = self::mask(-61, 47, request.chunk_x * 16 - 1, request.chunk_z * 16 - 1);
+    let mut reference = ChunkScratch {
+        reference_sections: true,
+        ..Default::default()
+    };
+    let mut candidate = ChunkScratch::default();
+    let light = vec![0x5f; (request.height as usize / 16 + 2) * 4096];
+    for iteration in 0..4 {
+        if iteration == 2 {
+            blocks.fill(3);
+            summary.fill(Some(3));
+        }
+        for lit in [false, true] {
+            for coverage in [Some(&mask), Some(&partial), None] {
+                for scratch in [&mut reference, &mut candidate] {
+                    encode_chunk(
+                        request,
+                        &columns,
+                        &blocks,
+                        123,
+                        "test:biome_0",
+                        Some(&profile),
+                        coverage,
+                        None,
+                        lit.then(|| crate::lighting::ChunkLight::new(&light, None)),
+                        Some(&summary),
+                        scratch,
+                    );
+                }
+                assert_eq!(
+                    candidate.nbt.0,
+                    reference.nbt.0,
+                    "iteration={iteration} lit={lit} mask={}",
+                    coverage.is_some()
+                );
+            }
+        }
+    }
+}
+
+#[test]
+#[ignore = "bounded CPU NBT comparison; use 30-second process-group deadline"]
+fn section_encoding_comparison() {
+    let (profile, request, columns, blocks, mask, summary) = fixture();
+    let mut scratch = [
+        ChunkScratch {
+            reference_sections: true,
+            ..Default::default()
+        },
+        ChunkScratch::default(),
+    ];
+    let light = vec![0x5f; (request.height as usize / 16 + 2) * 4096];
+    let mut times = [Vec::new(), Vec::new()];
+    for pair in 0..12 {
+        for step in 0..2 {
+            let variant = (pair + step) % 2;
+            let start = Instant::now();
+            for _ in 0..1024 {
+                encode_chunk(
+                    request,
+                    black_box(&columns),
+                    black_box(&blocks),
+                    123,
+                    "test:biome_0",
+                    Some(&profile),
+                    Some(&mask),
+                    None,
+                    Some(crate::lighting::ChunkLight::new(&light, None)),
+                    Some(&summary),
+                    &mut scratch[variant],
+                );
+                black_box(&scratch[variant].nbt.0);
+            }
+            if pair >= 2 {
+                times[variant].push(start.elapsed().as_secs_f64() * 1000.);
+            }
+        }
+        assert_eq!(scratch[0].nbt.0, scratch[1].nbt.0);
+    }
+    println!(
+        "{}",
+        serde_json::json!({"scope":"1024 synthetic height-64 lit chunks; encoding only","reference_ms":times[0],"reuse_ms":times[1],"exact":true})
+    );
+}
