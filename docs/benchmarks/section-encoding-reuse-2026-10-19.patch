+    let mut p: WorldProfile = serde_json::from_value(serde_json::json!({
+        "biome_scale":256,"blend":0.55,"sea_level":32,"stone":1,"water":3,
+        "bedrock":1,"deepslate":1,"snow":0,"ice":3,
+        "materials":["minecraft:air","minecraft:stone",{"id":"minecraft:oak_leaves","properties":{"persistent":"true"}},"minecraft:water"],
+        "biomes":(0..3).map(|i| serde_json::json!({"id":format!("test:biome_{i}"),"climate":[0,0,0,0],"terrain":[0,1,1],"top":1,"filler":1,"underwater":1,"flags":0})).collect::<Vec<_>>(),
+        "noises":[],"material_flags":[0,1,1,0],"heightmap_masks":[0,63,31,51]
+    })).unwrap();
+    p.material_nbt = p.materials.iter().map(material_nbt).collect();
+    let request = ChunkRequest {
+        seed: 42,
+        chunk_x: -2,
+        chunk_z: 3,
+        min_y: -64,
+        height: 64,
+        base_height: 0.,
+        amplitude: 0.,
+        frequency: 0.008,
+        reserved: 0,
+    };
+    let columns = vec![
+        Column {
+            height: -32,
+            packed: 3 << 24,
+            materials: 1 | (1 << 16)
+        };
+        256
+    ];
+    let blocks: Vec<u16> = (0..16384)
+        .map(|i| match i / 4096 {
+            0 => 1,
+            1 => (i % 4) as u16,
+            2 => 0,
+            _ => {
+                if i == 16383 {
+                    2
+                } else {
+                    0
+                }
+            }
+        })
+        .collect();
+    let summary = vec![Some(1), None, Some(0), None];
+    let mask = mask(-64, 64, request.chunk_x * 16 - 1, request.chunk_z * 16 - 1);
+    (p, request, columns, blocks, mask, summary)
+}
