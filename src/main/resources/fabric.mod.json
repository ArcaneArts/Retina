{
  "schemaVersion": 1,
  "id": "retina",
  "version": "${version}",
  "name": "Retina",
  "description": "Retina for Minecraft 26.3.",
  "authors": ["Arcane Arts"],
  "contact": {
    "sources": "https://github.com/ArcaneArts/Retina",
    "issues": "https://github.com/ArcaneArts/Retina/issues"
  },
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": ["art.arcane.retina.fabric.RetinaFabric"],
    "client": ["art.arcane.retina.fabric.RetinaFabricClient"]
  },
  "mixins": [
    "retina.mixins.json",
    {
      "config": "retina.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
